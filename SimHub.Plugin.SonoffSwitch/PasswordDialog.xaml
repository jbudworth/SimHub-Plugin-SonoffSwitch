<Window x:Class="SimHub.Plugin.SonoffSwitch.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
        Title="Set device password" Height="170" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Enter the device's web admin password:"/>
        <PasswordBox Grid.Row="1" x:Name="PasswordInput" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10" Padding="4,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click">Cancel</styles:SHButtonSecondary>
            <styles:SHButtonPrimary Height="28" VerticalAlignment="Center" IsDefault="True" Click="OkButton_Click">OK</styles:SHButtonPrimary>
        </StackPanel>
    </Grid>
</Window>
