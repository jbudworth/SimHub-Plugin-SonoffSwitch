<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>SimHub.Plugin.SonoffSwitch</RootNamespace>
    <AssemblyName>SimHub.Plugin.SonoffSwitch</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- Path to your local SimHub installation. Override in a SimHub.Plugin.SonoffSwitch.csproj.user
         file, or pass /p:SimHubInstallPath="C:\path\to\SimHub" on the command line, if SimHub
         is not installed at the default location below. -->
    <SimHubInstallPath Condition="'$(SimHubInstallPath)'==''">C:\Program Files (x86)\SimHub</SimHubInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />

    <!--
      SimHub does not ship its plugin SDK on NuGet: the two assemblies below come from
      your SimHub installation folder. Two ways to satisfy these references:

      1) Easiest: leave SimHubInstallPath at its default (or set it, see above) and these
         HintPaths will resolve straight from your installed copy of SimHub, OR

      2) Portable: copy SimHub.Plugins.dll and GameReaderCommon.dll from your SimHub folder
         into the .\lib folder next to this project, and switch the HintPath below to
         "lib\SimHub.Plugins.dll" / "lib\GameReaderCommon.dll".
    -->
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubInstallPath)\SimHub.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubInstallPath)\GameReaderCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubInstallPath)\log4net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json">
      <Version>13.0.3</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SonoffPlugin.cs" />
    <Compile Include="SonoffDeviceConfig.cs" />
    <Compile Include="SonoffPluginSettings.cs" />
    <Compile Include="SonoffExportDto.cs" />
    <Compile Include="TasmotaClient.cs" />
    <Compile Include="DeviceRuntimeState.cs" />
    <Compile Include="DeviceRow.cs" />
    <Compile Include="PasswordMaskConverter.cs" />
    <Compile Include="PasswordProtector.cs" />
    <Page Include="PasswordDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="PasswordDialog.xaml.cs">
      <DependentUpon>PasswordDialog.xaml</DependentUpon>
    </Compile>
    <Page Include="SettingsControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="SettingsControl.xaml.cs">
      <DependentUpon>SettingsControl.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="lib\README.txt" />
  </ItemGroup>

  <!-- Convenience: after building, drop the DLL straight into SimHub's plugin folder so
       F5 / Build immediately updates the copy SimHub loads. Safe to remove if you'd rather
       copy the DLL in manually. -->
  <Target Name="CopyToSimHub" AfterTargets="Build" Condition="Exists('$(SimHubInstallPath)')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(SimHubInstallPath)" ContinueOnError="true" />
    <Copy SourceFiles="$(OutDir)Newtonsoft.Json.dll" DestinationFolder="$(SimHubInstallPath)" ContinueOnError="true" Condition="Exists('$(OutDir)Newtonsoft.Json.dll')" />
  </Target>

</Project>
