<UserControl x:Class="SimHub.Plugin.SonoffSwitch.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimHub.Plugin.SonoffSwitch"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">
    <UserControl.Resources>
        <local:PasswordMaskConverter x:Key="PasswordMaskConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sonoff TH10 / TH16 Control (Tasmota firmware)"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <styles:SHButtonSecondary x:Name="ExportButton" Height="28" VerticalAlignment="Center" Margin="0,0,8,0" Click="ExportButton_Click">Export</styles:SHButtonSecondary>
                    <styles:SHButtonSecondary x:Name="ImportButton" Height="28" VerticalAlignment="Center" Margin="0,0,8,0" Click="ImportButton_Click">Import</styles:SHButtonSecondary>
                    <styles:SHButtonPrimary x:Name="SaveButton" Height="28" VerticalAlignment="Center" Click="SaveButton_Click">Save settings</styles:SHButtonPrimary>
                </StackPanel>
                <TextBlock x:Name="SavedLabel" Grid.Row="1" Grid.Column="1" Text="Saved." Margin="0,0,0,0"
                           HorizontalAlignment="Right" Opacity="0"/>
            </Grid>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8">
                This plugin talks to Sonoff TH10/TH16 switches over your local network using
                Tasmota firmware's HTTP API. Devices must already be flashed with Tasmota and
                joined to your Wi-Fi. Stock eWeLink firmware is not supported since it only
                offers a cloud API.
            </TextBlock>

            <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                <styles:SHSection Title="Devices" ShowSeparator="True">
                    <StackPanel Margin="0,8,0,0">
                        <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False"
                                  ItemsSource="{Binding Devices}" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,10"
                                  RowHeight="36" CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridCheckBoxColumn Header="Auth?" Binding="{Binding UseAuth}" Width="55"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTemplateColumn Header="Password" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Password, Converter={StaticResource PasswordMaskConverter}}"
                                                       VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Margin="0,0,4,0"
                                                        Tag="{Binding}" Click="RowTestButton_Click">Test</styles:SHButtonSecondary>
                                                <styles:SHButtonSecondary Height="28" VerticalAlignment="Center" Margin="0,0,4,0"
                                                        Tag="{Binding}" Click="RowSetPasswordButton_Click">Password</styles:SHButtonSecondary>
                                                <styles:SHButtonSecondary Height="28" VerticalAlignment="Center"
                                                        Tag="{Binding}" Click="RowRemoveButton_Click">Remove</styles:SHButtonSecondary>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal">
                            <styles:SHButtonSecondary x:Name="AddButton" Height="28" VerticalAlignment="Center" Margin="0,0,8,0" Click="AddButton_Click">Add</styles:SHButtonSecondary>
                            <styles:SHButtonSecondary x:Name="RefreshButton" Height="28" VerticalAlignment="Center" Margin="0,0,20,0" Click="RefreshButton_Click">Refresh</styles:SHButtonSecondary>
                            <TextBlock Text="Poll interval (ms):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="PollIntervalBox" Width="80" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </styles:SHSection>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
